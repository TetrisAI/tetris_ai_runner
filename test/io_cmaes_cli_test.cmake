if(NOT DEFINED TRAINER OR NOT DEFINED OUT)
    message(FATAL_ERROR "TRAINER and OUT are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(OUT "${OUT}/${suffix}")
file(MAKE_DIRECTORY "${OUT}")

function(train name)
    execute_process(COMMAND "${TRAINER}" --out "${OUT}/${name}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "trainer failed (${result}); artifacts: ${OUT}\n${output}\n${errors}")
    endif()
endfunction()

function(compare first second)
    foreach(name best.params mean.params games.csv)
        file(READ "${OUT}/${first}/${name}" a)
        file(READ "${OUT}/${second}/${name}" b)
        if(name STREQUAL "games.csv")
            string(REGEX REPLACE ",[0-9]+\n" ",<wall>\n" a "${a}")
            string(REGEX REPLACE ",[0-9]+\n" ",<wall>\n" b "${b}")
        endif()
        if(NOT a STREQUAL b)
            message(FATAL_ERROR "${name} differs for ${first} and ${second}; artifacts: ${OUT}")
        endif()
    endforeach()
endfunction()

set(tiny --seed 71 --groups 2 --max-groups 2 --own 4 --ratios 1
    --opponent-cadence constant --nodes 64 --next 10 --max-minutes 0.001
    --validate-every 1 --validation-seeds 1)

train(auto_one ${tiny} --generations 1 --workers 1)
train(auto_four ${tiny} --generations 1 --workers 4)
compare(auto_one auto_four)

file(READ "${OUT}/auto_one/mean.params" before_flat)
train(auto_one --resume --generations 2 --workers 1)
file(READ "${OUT}/auto_one/mean.params" after_flat)
if(NOT before_flat STREQUAL after_flat)
    message(FATAL_ERROR "a flat batch moved the optimizer mean; artifacts: ${OUT}")
endif()

train(straight ${tiny} --lambda 4 --patience 2 --restarts 2 --workers 1)
train(resumed ${tiny} --lambda 4 --patience 2 --restarts 2 --workers 4 --generations 3)
file(READ "${OUT}/resumed/best.params" champion)
train(resumed --resume --workers 3)
compare(straight resumed)
file(READ "${OUT}/resumed/best.params" final_champion)
if(NOT champion STREQUAL final_champion)
    message(FATAL_ERROR "flat validation replaced the champion; artifacts: ${OUT}")
endif()

file(STRINGS "${OUT}/straight/games.csv" rows)
set(generations "")
foreach(row IN LISTS rows)
    if(row MATCHES "^train,([0-9]+),")
        list(APPEND generations "${CMAKE_MATCH_1}")
    endif()
endforeach()
list(REMOVE_DUPLICATES generations)
if(NOT generations STREQUAL "0;1;2;3;4;5")
    message(FATAL_ERROR "expected two stagnant rounds per search and two restarts; artifacts: ${OUT}")
endif()

train(resumed --resume --workers 2)
compare(straight resumed)

# A real pending challenger without timing: a directory at mean.params.tmp fails the write that follows the checkpoint,
# so the trainer exits right after persisting generation 1's challenger and before validating it. Resuming at the
# generation cap must play only that validation (whose stagnation triggers the restart), then match an unbroken run.
set(pending ${tiny} --lambda 4 --patience 2 --restarts 1)
train(uninterrupted ${pending} --workers 1)
train(interrupted ${pending} --workers 4 --generations 1)
file(MAKE_DIRECTORY "${OUT}/interrupted/mean.params.tmp")
execute_process(COMMAND "${TRAINER}" --out "${OUT}/interrupted" --resume --workers 2 --generations 2
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 120)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "a failed mean.params write must stop the trainer with status 1 (${result}); artifacts: ${OUT}\n${output}\n${errors}")
endif()
file(REMOVE_RECURSE "${OUT}/interrupted/mean.params.tmp")
file(READ "${OUT}/interrupted/checkpoint.txt" checkpoint)
if(NOT checkpoint MATCHES "\nvalidations 1\n" OR NOT checkpoint MATCHES "\nprogress 2 1 0 0\nchallenger 1 [^\n]+\n")
    message(FATAL_ERROR "the checkpoint must hold generation 1's pending challenger; artifacts: ${OUT}")
endif()
file(READ "${OUT}/interrupted/games.csv" trained)
if(NOT trained MATCHES "\ntrain,1," OR trained MATCHES "\nvalid,1,")
    message(FATAL_ERROR "generation 1 must be trained but not validated; artifacts: ${OUT}")
endif()

train(interrupted --resume --workers 1 --generations 2)
file(READ "${OUT}/interrupted/checkpoint.txt" checkpoint)
if(NOT checkpoint MATCHES "\nvalidations 2\n" OR NOT checkpoint MATCHES "\nprogress 2 0 1 0\nchallenger 0\n")
    message(FATAL_ERROR "resume at the generation cap must validate the pending challenger and restart; artifacts: ${OUT}")
endif()
file(READ "${OUT}/interrupted/games.csv" drained)
string(LENGTH "${trained}" length)
string(SUBSTRING "${drained}" 0 ${length} kept)
if(NOT kept STREQUAL trained)
    message(FATAL_ERROR "resume rewrote earlier games; artifacts: ${OUT}")
endif()
string(SUBSTRING "${drained}" ${length} -1 appended)
string(REGEX REPLACE "valid,1,[^\n]*\n" "" other "${appended}")
string(REGEX MATCHALL "\nvalid,0," first "${drained}")
string(REGEX MATCHALL "\nvalid,1," second "${drained}")
list(LENGTH first first)
list(LENGTH second second)
if(NOT other STREQUAL "" OR first EQUAL 0 OR NOT first EQUAL second)
    message(FATAL_ERROR "resume at the generation cap must add exactly one validation panel and no training; artifacts: ${OUT}")
endif()

train(interrupted --resume --workers 2)
compare(uninterrupted interrupted)
foreach(name uninterrupted interrupted)
    file(READ "${OUT}/${name}/checkpoint.txt" checkpoint)
    string(REGEX REPLACE "\nwall_seconds [^\n]*" "\nwall_seconds <wall>" ${name}_checkpoint "${checkpoint}")
endforeach()
if(NOT uninterrupted_checkpoint STREQUAL interrupted_checkpoint)
    message(FATAL_ERROR "checkpoint.txt differs for uninterrupted and interrupted; artifacts: ${OUT}")
endif()
if(NOT interrupted_checkpoint MATCHES "\nvalidations 4\n" OR NOT interrupted_checkpoint MATCHES "\nprogress 4 2 1 1\nchallenger 0\n")
    message(FATAL_ERROR "the pending-challenger run must converge after four validations and one restart; artifacts: ${OUT}")
endif()

file(REMOVE_RECURSE "${OUT}")
message(STATUS "io_cmaes CLI: worker-independent defaults, bounded convergence, champion retention, pending validation at the generation cap and exact resume passed")
