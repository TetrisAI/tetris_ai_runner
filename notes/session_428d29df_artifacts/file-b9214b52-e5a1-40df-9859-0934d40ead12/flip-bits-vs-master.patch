+  static bool is_prime_(size_type candidate) {
+    if ((candidate & 1) != 0) {
+      size_type limit = size_type(std::sqrt(candidate));
+      for (size_type divisor = 3; divisor <= limit; divisor += 2) {
+        if ((candidate % divisor) == 0) {
+          return false;
+        }
+      }
+      return true;
+    }
+    return (candidate == 2);
+  }
