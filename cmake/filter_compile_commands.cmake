cmake_minimum_required(VERSION 3.19)

file(READ "${IN}" db)
string(JSON count LENGTH "${db}")
set(seen "")
set(entries "")
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON entry GET "${db}" ${i})
        string(JSON source GET "${entry}" file)
        if(source MATCHES "${REGEX}" AND NOT source IN_LIST seen)
            list(APPEND seen "${source}")
            string(APPEND entries "${entry},\n")
        endif()
    endforeach()
endif()
string(REGEX REPLACE ",\n$" "\n" entries "${entries}")
set(result "[\n${entries}]\n")

if(EXISTS "${OUT}" AND NOT IS_SYMLINK "${OUT}")
    file(READ "${OUT}" previous)
    if(previous STREQUAL result)
        return()
    endif()
endif()
file(REMOVE "${OUT}")
file(WRITE "${OUT}" "${result}")
