# d_diff_compare.cmake - run OLD/NEW, strip first MODE= line, byte-compare bodies.
execute_process(COMMAND ${NEW} OUTPUT_FILE ${BODY}_new.out RESULT_VARIABLE rc_new)
if(NOT rc_new EQUAL 0)
  message(FATAL_ERROR "NEW side failed rc=${rc_new}")
endif()
execute_process(COMMAND ${OLD} OUTPUT_FILE ${BODY}_old.out RESULT_VARIABLE rc_old)
if(NOT rc_old EQUAL 0)
  message(FATAL_ERROR "OLD side failed rc=${rc_old}")
endif()
file(READ ${BODY}_new.out new_txt)
file(READ ${BODY}_old.out old_txt)
string(REGEX REPLACE "^[^\n]*\n" "" new_body "${new_txt}")
string(REGEX REPLACE "^[^\n]*\n" "" old_body "${old_txt}")
if(NOT new_body STREQUAL old_body)
  message(FATAL_ERROR "framework_ai_d_diff: OLD vs NEW body differs")
endif()
message(STATUS "framework_ai_d_diff: OLD vs NEW body byte-identical")
